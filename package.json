{
  "name": "@hdx/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build:web": "vite build",
    "dev:local": "tauri dev --config src-tauri/tauri.local.conf.json --features flavor-local",
    "dev:online": "tauri dev --config src-tauri/tauri.online.conf.json --features flavor-online",
    "build:local": "tauri build --config src-tauri/tauri.local.conf.json --features flavor-local",
    "build:online": "tauri build --config src-tauri/tauri.online.conf.json --features flavor-online",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "typescript": "^5.8.0",
    "vite": "^8.0.8"
  }
}
